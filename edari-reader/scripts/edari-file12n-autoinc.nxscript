<%
function UrlDecode(const s: string): string;
var
  i: integer;
  hex: string;
begin
  Result := '';
  i := 1;
  while i <= Length(s) do
  begin
    if s[i] = '+' then
    begin
      Result := Result + ' ';
      Inc(i);
    end
    else if (s[i] = '%') and (i + 2 <= Length(s)) then
    begin
      hex := Copy(s, i + 1, 2);
      Result := Result + Chr(StrToInt('$' + hex));
      i := i + 3;
    end
    else
    begin
      Result := Result + s[i];
      Inc(i);
    end;
  end;
end;

var
  aSession: TnxSession;
  adb: TnxDatabase;
  aTable: TnxTable;
  aliasName, maintKey, tableName, tableUpper: string;
  autoIncVal: integer;
begin
  aliasName := UrlDecode(Trim(Request('alias')));
  maintKey := UrlDecode(Trim(Request('key')));
  tableName := UrlDecode(Trim(Request('table')));
  autoIncVal := StrToIntDef(UrlDecode(Trim(Request('autoinc'))), -1);

  if aliasName = '' then
  begin
    Output.Write('{"ok":false,"error":"alias required"}');
    Exit;
  end;

  if maintKey <> 'edari-receipt-maint' then
  begin
    Output.Write('{"ok":false,"error":"maintenance key required"}');
    Exit;
  end;

  if autoIncVal < 0 then
  begin
    Output.Write('{"ok":false,"error":"autoinc required"}');
    Exit;
  end;

  if tableName = '' then tableName := 'File12n';
  tableUpper := UpperCase(tableName);
  if tableUpper = 'FILE11N' then
    tableName := 'File11n'
  else if tableUpper = 'FILE12N' then
    tableName := 'File12n'
  else
  begin
    Output.Write('{"ok":false,"error":"table not allowed"}');
    Exit;
  end;

  aSession := TnxSession.Create(nil);
  adb := TnxDatabase.Create(nil);
  aTable := TnxTable.Create(nil);
  try
    aSession.ServerEngine := ServerEngine;
    aSession.Active := true;
    adb.AliasName := aliasName;
    adb.Session := aSession;
    adb.Open;
    aTable.Database := adb;
    aTable.TableName := tableName;
    aTable.Open;
    aTable.SetAutoIncValue(autoIncVal);
    Output.Write('{"ok":true,"table":"'+tableName+'","autoinc":'+IntToStr(autoIncVal)+',"viaResetAutoInc":true}');
  finally
    aTable.Free;
    adb.Free;
    aSession.Free;
  end;
end.
%>
